# Independent Ghostty setup for keyboard practice.
font-size = 16
background-opacity = .70
background-blur = 20
window-padding-x = 10
window-padding-y = 10
cursor-style = block
cursor-style-blink = true
confirm-close-surface = true
theme = Catppuccin Macchiato

# These shortcuts work on macOS and Fedora without taking Neovim's Ctrl-h/j/k/l.
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+backslash=new_split:down
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+z=toggle_split_zoom
